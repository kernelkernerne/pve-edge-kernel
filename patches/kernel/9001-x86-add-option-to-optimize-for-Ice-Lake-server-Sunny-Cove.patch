From: pve-edge-kernel <root@localhost>
Date: Fri, 16 Oct 2026 15:40:00 +0530
Subject: [PATCH] x86: add option to optimize for Ice Lake server (Sunny Cove)

Add CONFIG_X86_MARCH_ICELAKE_SERVER, which builds the kernel with
-march=icelake-server and the Rust equivalent target-cpu, as an explicit
and host-independent alternative to CONFIG_X86_NATIVE_CPU.

---
--- a/arch/x86/Kconfig.cpu
+++ b/arch/x86/Kconfig.cpu
@@ -229,6 +229,20 @@
 
 	  If unsure, say N.
 
+config X86_MARCH_ICELAKE_SERVER
+	bool "Build and optimize for Intel Ice Lake server (Sunny Cove)"
+	depends on X86_64
+	depends on !X86_NATIVE_CPU
+	depends on $(cc-option,-march=icelake-server)
+	help
+	  Build the kernel with -march=icelake-server, targeting 3rd gen
+	  Xeon Scalable (Ice Lake-SP) and other Sunny Cove based CPUs.
+
+	  The resulting kernel will not boot on CPUs lacking the
+	  instruction set extensions of Sunny Cove.
+
+	  If unsure, say N.
+
 config X86_GENERIC
 	bool "Generic x86 support"
 	depends on X86_32
--- a/arch/x86/Makefile
+++ b/arch/x86/Makefile
@@ -167,6 +167,9 @@
 
         # generate_rust_target.rs handles Rust APX gating.
         KBUILD_RUSTFLAGS += -Ctarget-cpu=native
+else ifdef CONFIG_X86_MARCH_ICELAKE_SERVER
+        KBUILD_CFLAGS += -march=icelake-server -mtune=icelake-server
+        KBUILD_RUSTFLAGS += -Ctarget-cpu=icelake-server
 else
         KBUILD_CFLAGS += -march=x86-64 -mtune=generic
         KBUILD_RUSTFLAGS += -Ctarget-cpu=x86-64 -Ztune-cpu=generic
