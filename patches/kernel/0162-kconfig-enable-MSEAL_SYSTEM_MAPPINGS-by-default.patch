From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Levente Polyak <levente@leventepolyak.net>
Date: Wed, 14 May 2025 21:00:09 +0200
Subject: [PATCH] kconfig: enable MSEAL_SYSTEM_MAPPINGS by default

Signed-off-by: Levente Polyak <levente@leventepolyak.net>
(cherry picked from commit b3995247268907b6a0b154372bc5ccf8111a7fe2)
---
 security/Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/security/Kconfig b/security/Kconfig
index aae25dff2ec9acf90ca566897c32fa72fe008cf9..7b4b1707ea7c5c75a6d78580ab833e9884ae0310 100644
--- a/security/Kconfig
+++ b/security/Kconfig
@@ -54,6 +54,7 @@ config MSEAL_SYSTEM_MAPPINGS
 	depends on 64BIT
 	depends on ARCH_SUPPORTS_MSEAL_SYSTEM_MAPPINGS
 	depends on !CHECKPOINT_RESTORE
+	default y
 	help
 	  Apply mseal on system mappings.
 	  The system mappings includes vdso, vvar, vvar_vclock,
