From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Micay <danielmicay@gmail.com>
Date: Sun, 28 May 2017 03:03:46 -0400
Subject: [PATCH] disable NFS_DEBUG by default

(cherry picked from commit 6bb24532c91ceb70385a57332911e21227b6ec7b)
---
 fs/nfs/Kconfig | 1 -
 1 file changed, 1 deletion(-)

diff --git a/fs/nfs/Kconfig b/fs/nfs/Kconfig
index 6bb30543eff00fa550093d35c099d79802e99720..c6951309ff24cfd0467bab48ea374e52c2748d75 100644
--- a/fs/nfs/Kconfig
+++ b/fs/nfs/Kconfig
@@ -198,7 +198,6 @@ config NFS_USE_KERNEL_DNS
 config NFS_DEBUG
 	bool
 	depends on NFS_FS && SUNRPC_DEBUG
-	default y
 
 config NFS_DISABLE_UDP_SUPPORT
        bool "NFS: Disable NFS UDP protocol support"
