From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Micay <danielmicay@gmail.com>
Date: Sun, 9 Jul 2017 17:20:29 -0400
Subject: [PATCH] support overriding early audit kernel cmdline

(cherry picked from commit 66b708befe38f91a60e128fd58996a6536d1dcf3)
---
 kernel/audit.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/kernel/audit.c b/kernel/audit.c
index 9412af9144bc9a8db057f553a276c4256798d95d..34c2d4b04762d95b3dab63e9e9c51806110e53c5 100644
--- a/kernel/audit.c
+++ b/kernel/audit.c
@@ -1789,6 +1789,9 @@ static int __init audit_enable(char *str)
 
 	if (audit_default == AUDIT_OFF)
 		audit_initialized = AUDIT_DISABLED;
+	else if (!audit_ever_enabled)
+		audit_initialized = AUDIT_UNINITIALIZED;
+
 	if (audit_set_enabled(audit_default))
 		pr_err("audit: error setting audit state (%d)\n",
 		       audit_default);
