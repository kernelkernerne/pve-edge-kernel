From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Micay <danielmicay@gmail.com>
Date: Mon, 29 May 2017 06:17:41 -0400
Subject: [PATCH] enable HARDENED_USERCOPY by default

Signed-off-by: Daniel Micay <danielmicay@gmail.com>
(cherry picked from commit 38622665036409156c52a2b9ca825413d59ec59f)
---
 security/Kconfig.hardening | 1 +
 1 file changed, 1 insertion(+)

diff --git a/security/Kconfig.hardening b/security/Kconfig.hardening
index 81c81ad983adb71f01614909cc721e6b8f1cdb08..a838119fd0789ef3b4983adb7f72cb6b4ae5271b 100644
--- a/security/Kconfig.hardening
+++ b/security/Kconfig.hardening
@@ -221,6 +221,7 @@ config FORTIFY_SOURCE
 config HARDENED_USERCOPY
 	bool "Harden memory copies between kernel and userspace"
 	imply STRICT_DEVMEM
+	default y
 	help
 	  This option checks for obviously wrong memory regions when
 	  copying memory to/from the kernel (via copy_to_user() and
