From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Micay <danielmicay@gmail.com>
Date: Wed, 3 May 2017 12:05:15 -0400
Subject: [PATCH] enable SECURITY_DMESG_RESTRICT by default

Signed-off-by: Daniel Micay <danielmicay@gmail.com>
(cherry picked from commit 22dfeb7d6be7df141300e3f884d07d62be730322)
---
 security/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/security/Kconfig b/security/Kconfig
index f7bf6cdc6229ebaf41fc72dcad22487ee626a513..3d5c65d2ca72b62298600e511fc07ee2a1f60b52 100644
--- a/security/Kconfig
+++ b/security/Kconfig
@@ -9,7 +9,7 @@ source "security/keys/Kconfig"
 
 config SECURITY_DMESG_RESTRICT
 	bool "Restrict unprivileged access to the kernel syslog"
-	default n
+	default y
 	help
 	  This enforces restrictions on unprivileged users reading the kernel
 	  syslog via dmesg(8).
