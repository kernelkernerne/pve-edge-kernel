From: Daniel Micay <danielmicay@gmail.com>
Date: Sat, 8 Jul 2017 02:38:54 -0400
Subject: [PATCH] disable SLAB_MERGE_DEFAULT by default

(cherry picked from commit fddfcfbd6eee07957138f4967d6c9399a25f61a3)
---
 mm/Kconfig | 1 -
 1 file changed, 1 deletion(-)

diff --git a/mm/Kconfig b/mm/Kconfig
index 10057a46bc1b1e0a9b765433e2c3608ad535d240..613e907d0d514d276582378e38be956def33da6d 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -185,7 +185,6 @@ config SLUB_TINY
 
 config SLAB_MERGE_DEFAULT
 	bool "Allow slab caches to be merged"
-	default y
 	help
 	  For reduced kernel memory fragmentation, slab caches can be
 	  merged when they share the same size and other characteristics.
