From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Levente Polyak <levente@leventepolyak.net>
Date: Tue, 12 Dec 2023 18:35:05 +0100
Subject: [PATCH] mm/slab: enable RANDOM_KMALLOC_CACHES by default

(cherry picked from commit 0c046ea1e5db117a3a97d9f970ccb4f11bb92d04)
---
 mm/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/Kconfig b/mm/Kconfig
index 71863bf0554ea9596bf303fcdae837c351f008d8..708a20205499db7c2777e34c46afcc9707d0dc3e 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -248,7 +248,7 @@ config SLUB_STATS
 config KMALLOC_PARTITION_CACHES
 	depends on !SLUB_TINY
 	bool "Partitioned slab caches for normal kmalloc"
-	default RANDOM_KMALLOC_CACHES
+	default y
 	help
 	  A hardening feature that creates multiple isolated copies of slab
 	  caches for normal kmalloc allocations. This makes it more difficult
